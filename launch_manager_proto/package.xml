<?xml version="1.0"?>
<package format="3">
  <name>launch_manager_proto</name>
  <version>0.0.0</version>
  <description>
    Prototype persistent launch and lifecycle manager: converges lifecycle nodes to a target
    state, runs launch-file groups on one shared LaunchService, reports and takes commands
    over plain std_msgs strings. It deliberately has no marine dependency.
  </description>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>BSD-2-Clause</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch_session</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
