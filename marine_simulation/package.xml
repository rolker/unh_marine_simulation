<?xml version="1.0"?>
<package format="2">
  <name>marine_simulation</name>
  <version>0.0.0</version>
  <description>
    Project11 packages related robot simulation
  </description>

  <author email="roland@ccom.unh.edu">Roland Arsenault</author>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <exec_depend>asv_helm</exec_depend>
  <exec_depend>asv_sim</exec_depend>
  <exec_depend>cube_bathymetry</exec_depend>
  <exec_depend>grid_map_rviz_plugin</exec_depend>
  <exec_depend>marine_autonomy</exec_depend>
  <exec_depend>mbes_sim</exec_depend>
  <exec_depend>mru_transform</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ben_gazebo</exec_depend>
  <exec_depend>portsmouth_nh_gazebo</exec_depend>
  <exec_depend>ben_project11</exec_depend>
  <exec_depend>camp</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>ben_description</exec_depend>
  <exec_depend>helm_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>joy_to_helm</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- imported by launch/demo_boats_launch.py and the demo scripts -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>marine_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <!-- this recursively depends on a set of common linters -->
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
